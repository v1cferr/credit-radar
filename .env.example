# Root configuration for the docker compose stack.
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Component-level configuration lives with each component:
#   backend/.env.example
#   frontend/.env.example

# --- Local development database ------------------------------------------
# Development-only values for a loopback-bound container. Do not reuse these
# anywhere that holds real data.
POSTGRES_USER=credit_radar
POSTGRES_PASSWORD=credit_radar
POSTGRES_DB=credit_radar

# --- Host ports -----------------------------------------------------------
# Defaults are offset from the conventional 5432/8000/3000 because this
# machine runs other projects that already hold those.
POSTGRES_HOST_PORT=5434
BACKEND_HOST_PORT=8007
FRONTEND_HOST_PORT=3007

# --- Logging ---------------------------------------------------------------
CREDIT_RADAR_LOG_LEVEL=INFO

# --- Reverse proxy ---------------------------------------------------------
# When served behind Caddy at credit.<domain>, the browser talks to the
# frontend origin and Caddy routes /api/* to the backend, so no cross-origin
# request is made. CORS still guards the backend port against a page that
# tries to reach it directly.
# CREDIT_RADAR_CORS_ORIGINS=https://credit.v1cferr.dev
