# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Database -------------------------------------------------------------
# Local development default matches docker-compose.yml. Port 5434 rather
# than 5432 because this machine runs other projects on the usual port.
CREDIT_RADAR_DATABASE_URL=postgresql+psycopg://credit_radar:credit_radar@localhost:5434/credit_radar

# --- Application ----------------------------------------------------------
# Bind to loopback by default: this service is private and must not be
# exposed to a network without a deliberate decision.
CREDIT_RADAR_API_HOST=127.0.0.1
CREDIT_RADAR_API_PORT=8000
CREDIT_RADAR_LOG_LEVEL=INFO

# --- Credentials for authenticated sources --------------------------------
# PLACEHOLDERS ONLY in this file. Real values belong in .env, which is
# git-ignored, and nowhere else.
#
# Set only what a source's login flow actually asks for. Nothing here needs a
# full name or a date of birth; `credit-radar credentials` reports what is
# missing without printing anything.
#
# This file holds a CPF and a password for a financial institution once it is
# filled in. Two consequences worth knowing:
#   - chmod 600 .env  (the app warns if it is readable beyond you)
#   - it lives on disk, so unlike a decrypted secret on a tmpfs it can
#     persist in local filesystem snapshots after you delete it.
#
# The environment wins over this file, so a deployment can inject a value
# without editing anything. That is also what keeps sops usable: sops-nix can
# render an env file and systemd inject it with EnvironmentFile=.

# Banco Central Registrato (gov.br sign-in; the CPF is the username)
# CREDIT_RADAR_SECRET_BCB_REGISTRATO_CPF=00000000000
# CREDIT_RADAR_SECRET_BCB_REGISTRATO_PASSWORD=replace-me

# --- Browser automation ----------------------------------------------------
# Chromium for authenticated sources. The Nix development shell sets this
# automatically; unset means "let Playwright decide", which works on a
# conventional distribution.
# CREDIT_RADAR_CHROMIUM_PATH=/usr/bin/chromium

# --- Outbound HTTP --------------------------------------------------------
# An explicit timeout is mandatory: the BCB SGS API hangs indefinitely on
# some invalid requests instead of returning an error status.
CREDIT_RADAR_HTTP_TIMEOUT_SECONDS=20.0
