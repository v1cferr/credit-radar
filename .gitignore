# --- Secrets and sensitive data -------------------------------------------
# This project handles credit, identity and financial information.
# Never relax these rules without a documented reason.
.env
.env.*
!.env.example
.env.local
frontend/.env*.local
*.pem
*.key
*.p12
secrets/
credentials/

# Authenticated browser state is a credential (see docs/security.md).
browser-profiles/
storage-state*.json
playwright/.auth/

# Raw provider captures may contain CPF, debts and account data.
data/raw/
data/personal/
captures/
screenshots/

# Fixtures derived from a REAL report, even after redaction. This repository
# is public, and a redacted credit report is still a document shaped by one
# person's finances: how many institutions, how many months, how many
# operations. Six separate leaks were found in one such file before it read
# clean, which is reason enough not to rely on getting the seventh right.
#
# Parser fixtures are SYNTHETIC and written by hand from the documented
# format (docs/providers/registrato.md), so they can be committed and
# reviewed by anyone. This entry exists so a broad `git add` cannot sweep a
# real one in, which is exactly how it happened once.
backend/tests/fixtures/registrato/scr.json
backend/tests/fixtures/**/from-real-report*

# --- Python / backend -----------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# --- Node / frontend ------------------------------------------------------
node_modules/
.next/
out/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Only pnpm is used for the frontend. A competing lockfile means two
# different dependency graphs claiming to describe the same app.
package-lock.json
yarn.lock
bun.lockb

# --- End-to-end test artefacts --------------------------------------------
# Traces and screenshots from a failed run. They can capture whatever the
# page was showing, so they are never committed even though the E2E data is
# synthetic.
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.playwright/

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.eslintcache

# --- Nix ------------------------------------------------------------------
result
result-*
.direnv/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
