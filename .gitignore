# --- Secrets and sensitive data -------------------------------------------
# This project handles credit, identity and financial information.
# Never relax these rules without a documented reason.
.env
.env.*
!.env.example
.env.local
frontend/.env*.local
*.pem
*.key
*.p12
secrets/
credentials/

# Authenticated browser state is a credential (see docs/security.md).
browser-profiles/
storage-state*.json
playwright/.auth/

# Raw provider captures may contain CPF, debts and account data.
data/raw/
data/personal/
captures/
screenshots/

# --- Python / backend -----------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# --- Node / frontend ------------------------------------------------------
node_modules/
.next/
out/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Only pnpm is used for the frontend. A competing lockfile means two
# different dependency graphs claiming to describe the same app.
package-lock.json
yarn.lock
bun.lockb

# --- Tooling caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.eslintcache

# --- Nix ------------------------------------------------------------------
result
result-*
.direnv/

# --- Editors / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
